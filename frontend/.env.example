# Backend origin for API requests (no trailing slash)
# Local development:
VITE_API_ORIGIN=http://localhost:8000
# Production (Render):
# VITE_API_ORIGIN=https://stack-overlords-backend.onrender.com

# Socket.IO origin (usually same as backend)
# Local development:
VITE_SOCKET_URL=http://localhost:8000
# Production (Render):
# VITE_SOCKET_URL=https://stack-overlords-backend.onrender.com
